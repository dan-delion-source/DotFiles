{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

  "display": {
    "separator": "   ",
    "key": {
      "width": 10
    },
    "color": {
      "keys": "bright_cyan",
      "separator": "dim_white",
      "output": "white",
      "title": "cyan"
    }
  },

  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logos/arch.txt",
    "padding": {
      "top": 2,
      "left": 6,
      "right": 6
    }
  },

  "modules": [
    {
      "type": "title",
      "format": "╭────────────── SYSTEM ──────────────╮"
    },

    { "type": "break" },

    {
      "type": "os",
      "key": "│ OS",
      "format": "{2}"
    },

    { "type": "break" },

    {
      "type": "command",
      "key": "│ KERNEL",
      "text": "uname -r | sed -E 's/^([0-9]+\\.[0-9]+\\.[0-9]+).*/\\1/'"
    },

    { "type": "break" },

    {
      "type": "uptime",
      "key": "│ UPTIME",
      "format": "{?1}{1}d {?}{?2}{2}h {?}{3}m"
    },

    { "type": "break" },

    {
      "type": "battery",
      "key": "│ BAT",
      "format": "{capacity}% ({status})"
    },

    { "type": "break" },

    {
      "type": "title",
      "format": "╰────────────────────────────────────╯"
    }
  ]
}
