    },
    {
      "name": "power-profiles-daemon.service",
      "scope": "system",
      "feature": "hardware"
    }
  ],
  "external_integrations": [
    "A default browser must already be selected with xdg-settings; browsers are not installed here.",
    "Face unlock and shared system avatars require existing upstream PAM/polkit helpers; this installer does not create them or change PAM.",
    "Hyprglass and dynamic cursor plugins are optional, guarded integrations. No plugin is built or installed.",
    "yay or paru is required only for selected packages absent from configured repositories; the installer does not bootstrap an AUR helper.",
    "wl-screenrec is an optional alternative to wf-recorder; convert is the legacy alternative to magick.",
    "howdy and v4l2-ctl are optional probes for existing face unlock; no camera is activated by installation.",
    "hyprshutdown is optional; session exit has a hyprctl fallback."
  ]
