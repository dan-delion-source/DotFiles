################
### PROGRAMS ###
################

# Set programs that you use
$terminal = kitty
$fileManager = ~/scripts/open_yazi.sh
$menu = rofi -show drun
$browser = zen-browser

################
### KEYBINDS ###
################

$mainMod = SUPER # Sets "Windows" key as main modifier

# Close Active Apps
bind = $mainMod, Q, killactive,

# Window Keybinds
bind = $mainMod SHIFT, V, togglefloating,
bind = $mainMod SHIFT, F, fullscreen
bind = $mainMod SHIFT, J, togglesplit,

# Open App Launcher
bind = $mainMod, SPACE, exec, $menu

# Terminal Emulator
bind = $mainMod, RETURN, exec, kitty
bind = $mainMod SHIFT, RETURN, exec, [float; size 700 600] kitty

# Open Yazi
bind = $mainMod, M, exec, sh ~/scripts/open_yazi.sh
bind = $mainMod SHIFT, M, exec, [float; size 525 260] sh ~/scripts/open_yazi.sh 

# Open Power Menu
bind = $mainMod, P, exec, sh ~/scripts/power_management.sh

# Open Browser
bind = $mainMod, B, exec, brave
bind = $mainMod, A, exec, antigravity
bind = $mainMod, T, exec, thunar
bind = $mainMod, L, exec, libreoffice
bind = $mainMod, G, exec, gedit
bind = $mainMod, V, exec, vmware
bind = $mainMod, C, exec, cursor
bind = $mainMod, I, exec, idea
bind = $mainMod, D, exec, discord


# EWW Stuff
bind = $mainMod SHIFT, W, exec, sh ~/scripts/select_wallpaper.sh 
bind = $mainMod, H, exec, sh ~/scripts/launch_widgets.sh
bind = $mainMod, R, exec, sh ~/scripts/launch.sh

# Reload Hyprpaper
bind = $mainMod SHIFT, A, exec, sh ~/scripts/hyprpaper_reload.sh

# Screen Shot
bind = $mainMod, PRINT, exec, hyprshot -m output
bind = $mainMod SHIFT, INSERT, exec, hyprshot -m region -o ~/Pictures/Screenshots

# Window focus
bind = ALT, left, movefocus, l
bind = ALT, right, movefocus, r
bind = ALT, up, movefocus, u
bind = ALT, down, movefocus, d

# Move Window
bind = ALT SHIFT, left, movewindow, l
bind = ALT SHIFT, right, movewindow, r
bind = ALT SHIFT, up, movewindow, u
bind = ALT SHIFT, down, movewindow, d 

# Resize Window
bind = $mainMod ALT, left, resizeactive, -40 0
bind = $mainMod ALT, right, resizeactive, 40 0
bind = $mainMod ALT, up, resizeactive, 0 -40
bind = $mainMod ALT, down, resizeactive, 0 40

# Move Floating Window
binde = $mainMod CTRL, left, moveactive, -40 0
binde = $mainMod CTRL, right, moveactive, 40 0
binde = $mainMod CTRL, up, moveactive, 0 -40
binde = $mainMod CTRL, down, moveactive, 0 40

# Volume and Media Control
bind = , XF86AudioRaiseVolume, exec, pamixer -i 5 
bind = , XF86AudioLowerVolume, exec, pamixer -d 5 
bind = , XF86AudioMicMute, exec, pamixer --default-source -t
bind = , XF86AudioMute, exec, pamixer -t

# Brightness Control
bind = , XF86MonBrightnessUp, exec, brightnessctl s +5%
bind = , XF86MonBrightnessDown, exec, brightnessctl s 5%-

# Switch workspaces with mainMod + [0-9]
bind = $mainMod, 1, workspace, 1
bind = $mainMod, 2, workspace, 2
bind = $mainMod, 3, workspace, 3
bind = $mainMod, 4, workspace, 4
bind = $mainMod, 5, workspace, 5
bind = $mainMod, 6, workspace, 6
bind = $mainMod, 7, workspace, 7
bind = $mainMod, 8, workspace, 8
bind = $mainMod, 9, workspace, 9
bind = $mainMod, 0, workspace, 10

# Move active window to a workspace with mainMod + SHIFT + [0-9]
bind = $mainMod SHIFT, 1, movetoworkspace, 1
bind = $mainMod SHIFT, 2, movetoworkspace, 2
bind = $mainMod SHIFT, 3, movetoworkspace, 3
bind = $mainMod SHIFT, 4, movetoworkspace, 4
bind = $mainMod SHIFT, 5, movetoworkspace, 5
bind = $mainMod SHIFT, 6, movetoworkspace, 6
bind = $mainMod SHIFT, 7, movetoworkspace, 7
bind = $mainMod SHIFT, 8, movetoworkspace, 8
bind = $mainMod SHIFT, 9, movetoworkspace, 9
bind = $mainMod SHIFT, 0, movetoworkspace, 10

# Scroll through existing workspaces with mainMod + scroll
bind = $mainMod, mouse_down, workspace, e+1
bind = $mainMod, mouse_up, workspace, e-1

# Move/resize windows with mainMod + LMB/RMB and dragging
bindm = $mainMod, mouse:272, movewindow
bindm = $mainMod, mouse:273, resizewindow
